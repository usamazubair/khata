# Postgres connection string.
# Local:  postgresql://khata:khata@localhost:5432/khata
# Neon:   postgresql://user:password@ep-xxxx.region.aws.neon.tech/khata?sslmode=require
DATABASE_URL=postgresql://khata:khata@localhost:5432/khata

# Shared secret the phone app and the web dashboard both send as the
# "x-api-key" header. Make up any long random string.
API_KEY=change-me-to-something-long-and-random

# Port the API listens on (Render sets this automatically in production).
PORT=4000
