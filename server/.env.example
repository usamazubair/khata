# Postgres connection string.
# Local:  postgresql://khata:khata@localhost:5432/khata
# Neon:   postgresql://user:password@ep-xxxx.region.aws.neon.tech/khata?sslmode=require
DATABASE_URL=postgresql://khata:khata@localhost:5432/khata

# Signs the login tokens. Make up a long random string and keep it secret —
# changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# The first admin account, created automatically on startup when there are no
# users yet. Safe to leave set afterwards; it's ignored once a user exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-a-strong-password
ADMIN_NAME=Admin

# Port the API listens on (Render sets this automatically in production).
PORT=4000
